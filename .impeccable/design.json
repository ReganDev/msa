  "narrative": {
    "northStar": "The Calm Clinic",
    "overview": "A quiet, well-lit treatment room. The site is a cool off-white ground with slate ink and one calm teal accent, so it reads as clean and unhurried rather than clinical-cold. Headings are set in Cormorant Garamond, which brings warmth and a sense of care; everything a patient has to read or act on is set in Jost, which keeps it plain and legible.\n\nDensity is comfortable, never packed: generous section padding, split section headings (title left, lead offset right) instead of centred stacks, and surfaces that rest rather than lift. Motion is short and opacity-led. Booking is the one action that is allowed to look different from everything else.",
    "keyCharacteristics": [
      "Cool paper ground (#f7f9fa), slate ink (#1e2a32), one teal accent (#2f7d8a).",
      "Serif headings for warmth, sans body for clarity.",
      "Soft, ink-tinted shadows; nothing glows.",
      "Rounded but not bubbly: three radius steps by surface rank.",
      "A single distinctive control: the split-capsule Book button."
    ],
    "rules": [
      { "name": "The One Accent Rule", "body": "Teal is the only hue. New UI uses the existing palette roles; it does not introduce a second accent.", "section": "colors" },
      { "name": "The Serif-For-Headings Rule", "body": "Cormorant never sets body copy, buttons, or form text; Jost never sets display headings.", "section": "typography" },
      { "name": "The Ink Shadow Rule", "body": "Shadows are tinted with the ink, never with teal. A coloured shadow reads as a glow, not a surface.", "section": "elevation" }
    ],
    "dos": [
      "Do keep teal for action and emphasis; let neutrals carry the page.",
      "Do use the split-capsule Book button for booking and nothing else.",
      "Do tint shadows with the ink (rgba(30, 55, 66, …)).",
      "Do keep red-flag safety notes visible and uncollapsed.",
      "Do respect prefers-reduced-motion; motion is opacity-led and under ~600ms."
    ],
    "donts": [
      "Don't introduce a second accent hue, gradients on text, or glows.",
      "Don't set body copy in Cormorant or headings in Jost.",
      "Don't make cards lift on hover.",
      "Don't add eyebrows to every section; one per hero.",
      "Don't fabricate testimonials, reviews or statistics to fill a layout."
    ]
  }
