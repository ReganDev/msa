# Contact form delivery — copy this file to `.env.local` and fill it in.
#
# `.env.local` is already gitignored (via the `*.local` rule). Do NOT use a
# plain `.env` file: that one is not ignored and would commit the key.
#
# In production these live in Vercel → Project → Settings → Environment
# Variables, NOT in this repo.
#
# Never prefix any of these with VITE_. Vite inlines VITE_* variables into the
# client bundle as readable text, which would publish the key to every visitor.

# Required. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Defaults to Resend's shared sender (onboarding@resend.dev), which
# works without domain verification but is only suitable for testing. Before
# going live, verify the site's domain in Resend and set an address on it here.
CONTACT_FROM="Knight Osteopathy <hello@example.co.uk>"

# Optional. Where enquiries are delivered. Defaults to EMAIL in src/data.ts.
CONTACT_TO=
